# Copy to `.env` for local overrides. Never commit `.env` with real values.

# local | ci
LAB_ENV=local

# ---------------------------------------------------------------------------
# Live LLM evaluation (Story 2.6, OPTIONAL and opt-in)
# ---------------------------------------------------------------------------
# Only `npm run ai:evaluate:live` reads these values, and only that command
# loads this file (Node 24 `--env-file-if-exists=.env`). Deterministic
# evaluation (`npm run ai:evaluate`) never reads them, and CI never calls the
# live evaluator. Live evaluation is a manual/local operation.
#
# Current provider: OpenRouter (OpenAI-compatible /chat/completions).
# Leave ASSISTANT_LIVE_API_KEY empty to keep live evaluation "unavailable".

# REQUIRED - a real key must never be committed to the repository.
ASSISTANT_LIVE_API_KEY=

# REQUIRED - no default is applied in code; documented default for OpenRouter:
# qwen/qwen3.8-27b:free (verify the model id against your own OpenRouter account).
ASSISTANT_LIVE_MODEL=qwen/qwen3.8-27b:free

# Optional - code default: https://openrouter.ai/api/v1
ASSISTANT_LIVE_BASE_URL=https://openrouter.ai/api/v1

# Optional - code default: 0
ASSISTANT_LIVE_TEMPERATURE=0

# Optional - omitted entirely when unset (sent as `max_tokens` when set)
ASSISTANT_LIVE_MAX_OUTPUT_TOKENS=

# Optional - code default: 30000
ASSISTANT_LIVE_TIMEOUT_MS=30000