{
  "consumer": {
    "name": "qa-lab-api-consumer"
  },
  "interactions": [
    {
      "description": "a request for an item by id",
      "providerStates": [
        {
          "name": "an item exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/items/item-0001"
      },
      "response": {
        "body": {
          "id": "item-0001",
          "name": "Notebook",
          "quantity": 2
        },
        "headers": {
          "Content-Type": "application/json",
          "content-type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.quantity": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
